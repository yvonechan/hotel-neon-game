{
  "name": "hotel-neon",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      },
      {
        "name": "SQL_LABS",
        "class_name": "SqlLab"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameRoom"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "SqlLab"
      ]
    }
  ]
}
